---
// src/pages/produto/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { getAllProducts, getProductBySlug } from '../../stores/products';
import { formatPrice } from '../../lib/format';

export async function getStaticPaths() {
  const products = await getAllProducts();
  return products.map(product => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;
---

<Layout title={product.name} description={product.description}>
  <div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div>
        <div class="aspect-square bg-gray-200 rounded-lg mb-4">
          <img src={product.images[0]} alt={product.name} class="w-full h-full object-cover rounded-lg" />
        </div>
      </div>

      <div>
        <h1 class="text-4xl font-bold mb-4">{product.name}</h1>
        
        <div class="flex items-baseline gap-4 mb-6">
          <span class="text-4xl font-bold text-primary">{formatPrice(product.price)}</span>
          {product.comparePrice && (
            <span class="text-xl text-gray-500 line-through">{formatPrice(product.comparePrice)}</span>
          )}
        </div>

        <p class="text-gray-700 mb-6">{product.description}</p>

        <div class="mb-6">
          <span class="text-sm text-gray-600">Estoque: </span>
          <span class="font-semibold">{product.stock} unidades</span>
        </div>

        <button 
          id="add-to-cart"
          data-product-id={product.id}
          data-price={product.price}
          class="w-full bg-primary text-white py-4 rounded-lg font-semibold text-lg hover:bg-primary/90 transition-colors mb-4"
        >
          Adicionar ao Carrinho
        </button>

        <div class="border-t pt-6">
          <h2 class="font-bold mb-4">Detalhes do Produto</h2>
          <ul class="space-y-2 text-sm text-gray-700">
            <li><strong>Categoria:</strong> {product.category}</li>
            <li><strong>Tags:</strong> {product.tags.join(', ')}</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { addToCart, cartOpen } from '../../stores/cart';
    
    document.getElementById('add-to-cart')?.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const productId = target.dataset.productId!;
      const price = parseFloat(target.dataset.price!);
      
      addToCart(productId, price);
      cartOpen.set(true);
    });
  </script>
</Layout>