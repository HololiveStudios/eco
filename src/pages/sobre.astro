---
// src/pages/sobre.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Sobre Nós" description="Conheça nossa história e valores">
    <!-- Hero Section -->
    <section
        class="relative bg-gradient-to-br from-primary via-blue-600 to-indigo-700 text-white py-32 overflow-hidden"
    >
        <div class="absolute inset-0 opacity-10">
            <div
                class="absolute top-0 left-0 w-96 h-96 bg-white rounded-full blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-0 right-0 w-96 h-96 bg-white rounded-full blur-3xl"
            >
            </div>
        </div>

        <div class="container mx-auto px-4 relative z-10">
            <div class="max-w-4xl mx-auto text-center">
                <h1 class="text-6xl font-bold mb-6 animate-fade-in">
                    Transformando a Experiência de Compra Online
                </h1>
                <p class="text-xl mb-8 text-blue-100 leading-relaxed">
                    Unimos tecnologia de ponta com atendimento humanizado para
                    criar a melhor experiência de e-commerce do mercado
                </p>
                <div class="flex gap-4 justify-center">
                    <a
                        href="/produtos"
                        class="bg-white text-primary px-8 py-4 rounded-lg font-bold text-lg hover:bg-gray-100 transition-all transform hover:scale-105 shadow-xl"
                    >
                        Explorar Produtos
                    </a>
                    <a
                        href="/contato"
                        class="border-2 border-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-white/10 transition-all"
                    >
                        Fale Conosco
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                <div class="p-6">
                    <div class="text-5xl font-bold text-primary mb-2">10k+</div>
                    <div class="text-gray-600">Clientes Satisfeitos</div>
                </div>
                <div class="p-6">
                    <div class="text-5xl font-bold text-primary mb-2">500+</div>
                    <div class="text-gray-600">Produtos</div>
                </div>
                <div class="p-6">
                    <div class="text-5xl font-bold text-primary mb-2">98%</div>
                    <div class="text-gray-600">Avaliação Positiva</div>
                </div>
                <div class="p-6">
                    <div class="text-5xl font-bold text-primary mb-2">24h</div>
                    <div class="text-gray-600">Entrega Rápida</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Story Section -->
    <section class="py-20 bg-gray-50">
        <div class="container mx-auto px-4">
            <div class="max-w-6xl mx-auto">
                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center"
                >
                    <div>
                        <h2 class="text-4xl font-bold mb-6">Nossa História</h2>
                        <p class="text-gray-700 mb-4 leading-relaxed">
                            Fundada em 2020, nascemos com a missão de
                            revolucionar o comércio eletrônico brasileiro. O que
                            começou como um pequeno projeto se transformou em
                            uma das plataformas mais inovadoras do mercado.
                        </p>
                        <p class="text-gray-700 mb-4 leading-relaxed">
                            Acreditamos que comprar online deve ser simples,
                            rápido e confiável. Por isso, investimos
                            continuamente em tecnologia e treinamento para
                            oferecer a melhor experiência possível.
                        </p>
                        <p class="text-gray-700 leading-relaxed">
                            Hoje, atendemos milhares de clientes em todo o
                            Brasil, mantendo o compromisso com qualidade e
                            excelência que nos trouxe até aqui.
                        </p>
                    </div>
                    <div class="relative">
                        <div
                            class="aspect-square bg-gradient-to-br from-primary to-blue-600 rounded-2xl"
                        >
                        </div>
                        <div
                            class="absolute -bottom-6 -right-6 w-64 h-64 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl opacity-50"
                        >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Values Section -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold mb-4">Nossos Valores</h2>
                <p class="text-gray-600 text-lg">
                    Os princípios que guiam cada decisão
                </p>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto"
            >
                <div
                    class="p-8 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl hover:shadow-xl transition-all transform hover:-translate-y-2"
                >
                    <div
                        class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mb-6"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4">Qualidade</h3>
                    <p class="text-gray-700 leading-relaxed">
                        Selecionamos cuidadosamente cada produto para garantir
                        que nossos clientes recebam apenas o melhor.
                    </p>
                </div>

                <div
                    class="p-8 bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl hover:shadow-xl transition-all transform hover:-translate-y-2"
                >
                    <div
                        class="w-16 h-16 bg-purple-600 rounded-full flex items-center justify-center mb-6"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4">Inovação</h3>
                    <p class="text-gray-700 leading-relaxed">
                        Utilizamos as tecnologias mais modernas para
                        proporcionar uma experiência de compra excepcional.
                    </p>
                </div>

                <div
                    class="p-8 bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl hover:shadow-xl transition-all transform hover:-translate-y-2"
                >
                    <div
                        class="w-16 h-16 bg-green-600 rounded-full flex items-center justify-center mb-6"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-4">Confiança</h3>
                    <p class="text-gray-700 leading-relaxed">
                        Transparência e segurança em cada transação. Seu
                        bem-estar é nossa prioridade número um.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section class="py-20 bg-gray-50">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold mb-4">Nossa Equipe</h2>
                <p class="text-gray-600 text-lg">
                    Pessoas apaixonadas por criar experiências incríveis
                </p>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-4 gap-8 max-w-6xl mx-auto"
            >
                {
                    [
                        {
                            name: "Ana Silva",
                            role: "CEO & Fundadora",
                            color: "from-blue-400 to-blue-600",
                        },
                        {
                            name: "Carlos Santos",
                            role: "CTO",
                            color: "from-purple-400 to-purple-600",
                        },
                        {
                            name: "Maria Oliveira",
                            role: "Head de Marketing",
                            color: "from-pink-400 to-pink-600",
                        },
                        {
                            name: "João Pereira",
                            role: "Head de Vendas",
                            color: "from-green-400 to-green-600",
                        },
                    ].map((member) => (
                        <div class="text-center group">
                            <div
                                class={`aspect-square bg-gradient-to-br ${member.color} rounded-2xl mb-4 group-hover:scale-105 transition-transform`}
                            />
                            <h3 class="font-bold text-xl mb-1">
                                {member.name}
                            </h3>
                            <p class="text-gray-600">{member.role}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Mission Section -->
    <section
        class="py-20 bg-gradient-to-br from-primary to-indigo-700 text-white"
    >
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto text-center">
                <h2 class="text-4xl font-bold mb-6">Nossa Missão</h2>
                <p class="text-xl leading-relaxed mb-8 text-blue-100">
                    "Democratizar o acesso a produtos de qualidade, criando uma
                    experiência de compra online que seja rápida, segura e
                    prazerosa para todos os brasileiros."
                </p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
                    <div class="p-6 bg-white/10 backdrop-blur-sm rounded-xl">
                        <div class="text-3xl font-bold mb-2">Acessível</div>
                        <p class="text-blue-100">Preços justos para todos</p>
                    </div>
                    <div class="p-6 bg-white/10 backdrop-blur-sm rounded-xl">
                        <div class="text-3xl font-bold mb-2">Sustentável</div>
                        <p class="text-blue-100">Compromisso com o planeta</p>
                    </div>
                    <div class="p-6 bg-white/10 backdrop-blur-sm rounded-xl">
                        <div class="text-3xl font-bold mb-2">Inclusivo</div>
                        <p class="text-blue-100">Para todos os brasileiros</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold mb-4">
                    O Que Dizem Nossos Clientes
                </h2>
                <p class="text-gray-600 text-lg">
                    Avaliações reais de quem já comprou conosco
                </p>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto"
            >
                {
                    [
                        {
                            text: "Melhor experiência de compra que já tive! Entrega super rápida e produto exatamente como descrito.",
                            author: "Fernanda Costa",
                            rating: 5,
                        },
                        {
                            text: "Atendimento impecável e produtos de altíssima qualidade. Já fiz várias compras e sempre satisfeito!",
                            author: "Ricardo Alves",
                            rating: 5,
                        },
                        {
                            text: "Site muito fácil de usar e o processo de checkout é super rápido. Recomendo!",
                            author: "Juliana Mendes",
                            rating: 5,
                        },
                    ].map((testimonial) => (
                        <div class="p-8 bg-gray-50 rounded-2xl">
                            <div class="flex gap-1 mb-4">
                                {[...Array(testimonial.rating)].map(() => (
                                    <svg
                                        class="w-5 h-5 text-yellow-400"
                                        fill="currentColor"
                                        viewBox="0 0 20 20"
                                    >
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                ))}
                            </div>
                            <p class="text-gray-700 mb-4 italic">
                                "{testimonial.text}"
                            </p>
                            <p class="font-semibold">{testimonial.author}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-primary to-blue-600 text-white">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl font-bold mb-6">Pronto Para Começar?</h2>
            <p class="text-xl mb-8 text-blue-100">
                Junte-se a milhares de clientes satisfeitos
            </p>
            <div class="flex gap-4 justify-center flex-wrap">
                <a
                    href="/produtos"
                    class="bg-white text-primary px-8 py-4 rounded-lg font-bold text-lg hover:bg-gray-100 transition-all transform hover:scale-105 shadow-xl"
                >
                    Ver Produtos
                </a>
                <a
                    href="/contato"
                    class="border-2 border-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-white/10 transition-all"
                >
                    Entre em Contato
                </a>
            </div>
        </div>
    </section>
</Layout>
