---
// src/pages/categorias/index.astro - NOVO
import Layout from "../../layouts/Layout.astro";
import { getAllCategories } from "../../stores/categories";

const categories = getAllCategories();
---

<Layout title="Categorias">
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-4xl font-bold mb-8">Categorias</h1>

        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {
                categories.map((category) => (
                    <a
                        href={`/categoria/${category.slug}`}
                        class="group bg-white rounded-lg shadow-sm hover:shadow-md transition-all overflow-hidden"
                    >
                        <div class="aspect-square bg-gradient-to-br from-primary/20 to-primary/10 flex items-center justify-center">
                            <svg
                                class="w-16 h-16 text-primary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                                />
                            </svg>
                        </div>
                        <div class="p-4">
                            <h3 class="font-bold text-lg mb-1 group-hover:text-primary transition-colors">
                                {category.name}
                            </h3>
                            {category.description && (
                                <p class="text-sm text-gray-600">
                                    {category.description}
                                </p>
                            )}
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</Layout>
