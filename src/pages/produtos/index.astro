---
// src/pages/produtos/index.astro
import Layout from '../../layouts/Layout.astro';
import ProductGrid from '../../components/ProductGrid';
import { getAllProducts } from '../../stores/products';

const products = await getAllProducts();
---

<Layout title="Produtos">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8">Todos os Produtos</h1>
    
    <div class="flex flex-col md:flex-row gap-8">
      <aside class="w-full md:w-64 shrink-0">
        <div class="bg-white p-4 rounded-lg shadow-sm">
          <h2 class="font-bold mb-4">Filtros</h2>
          
          <div class="mb-6">
            <h3 class="font-semibold mb-2">Categorias</h3>
            <label class="flex items-center gap-2 mb-2">
              <input type="checkbox" class="rounded" />
              <span>Categoria A</span>
            </label>
            <label class="flex items-center gap-2 mb-2">
              <input type="checkbox" class="rounded" />
              <span>Categoria B</span>
            </label>
          </div>

          <div class="mb-6">
            <h3 class="font-semibold mb-2">Preço</h3>
            <input type="range" min="0" max="1000" class="w-full" />
            <div class="flex justify-between text-sm text-gray-600 mt-1">
              <span>R$ 0</span>
              <span>R$ 1000</span>
            </div>
          </div>
        </div>
      </aside>

      <div class="flex-1">
        <ProductGrid products={products} client:load />
      </div>
    </div>
  </div>
</Layout>