---
// src/pages/offline.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Você está offline">
    <div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
        <div class="text-center max-w-md">
            <div class="mb-8">
                <svg
                    class="w-32 h-32 mx-auto text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3m8.293 8.293l1.414 1.414"
                    ></path>
                </svg>
            </div>

            <h1 class="text-4xl font-bold text-gray-900 mb-4">
                Você está offline
            </h1>
            <p class="text-lg text-gray-600 mb-8">
                Não foi possível conectar à internet. Algumas funcionalidades
                podem estar limitadas.
            </p>

            <div class="space-y-4">
                <button
                    onclick="window.location.reload()"
                    class="w-full bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors"
                >
                    Tentar Novamente
                </button>

                <a
                    href="/"
                    class="block w-full bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 transition-colors"
                >
                    Voltar ao Início
                </a>
            </div>

            <div class="mt-8 p-4 bg-blue-50 rounded-lg">
                <p class="text-sm text-blue-800">
                    <strong>Dica:</strong> Você ainda pode navegar por páginas que
                    já visitou!
                </p>
            </div>
        </div>
    </div>
</Layout>
