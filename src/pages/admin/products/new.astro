---
// src/pages/admin/products/new.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/admin/ProductForm';
---
<AdminLayout title="Novo Produto">
  <div class="bg-white p-6 rounded-lg shadow-sm max-w-4xl">
    <h2 class="text-2xl font-bold mb-6">Criar Novo Produto</h2>
    <ProductForm client:load />
  </div>
  <script>
    import { createProduct } from '../../../stores/admin-products';
    import { slugify } from '../../../lib/format';

    window.addEventListener('load', () => {
      const form = document.querySelector('form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          window.location.href = '/admin/products';
        });
      }
    });
  </script>
</AdminLayout>
