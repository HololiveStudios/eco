---
// src/pages/admin/settings/index.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Configurações">
  <div class="max-w-4xl space-y-6">
    <div class="bg-white p-6 rounded-lg shadow-sm">
      <h2 class="text-xl font-bold mb-4">Configurações da Loja</h2>
      <form class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-2">Nome da Loja</label>
          <input type="text" class="w-full px-4 py-2 border rounded-lg" value="Minha Loja" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">E-mail de Contato</label>
          <input type="email" class="w-full px-4 py-2 border rounded-lg" value="contato@loja.com" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Telefone</label>
          <input type="tel" class="w-full px-4 py-2 border rounded-lg" value="(00) 00000-0000" />
        </div>
        <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg">Salvar Alterações</button>
      </form>
    </div>
<div class="bg-white p-6 rounded-lg shadow-sm">
  <h2 class="text-xl font-bold mb-4">Configurações de Pagamento</h2>
  <div class="space-y-4">
    <label class="flex items-center gap-3">
      <input type="checkbox" checked class="rounded" />
      <span>Aceitar PIX</span>
    </label>
    <label class="flex items-center gap-3">
      <input type="checkbox" checked class="rounded" />
      <span>Aceitar Cartão de Crédito</span>
    </label>
    <label class="flex items-center gap-3">
      <input type="checkbox" checked class="rounded" />
      <span>Aceitar Boleto</span>
    </label>
  </div>
</div>

<div class="bg-white p-6 rounded-lg shadow-sm">
  <h2 class="text-xl font-bold mb-4">Configurações de Envio</h2>
  <form class="space-y-4">
    <div>
      <label class="block text-sm font-medium mb-2">Taxa de Envio Padrão (R$)</label>
      <input type="number" step="0.01" class="w-full px-4 py-2 border rounded-lg" value="15.00" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-2">Frete Grátis Acima de (R$)</label>
      <input type="number" step="0.01" class="w-full px-4 py-2 border rounded-lg" value="200.00" />
    </div>
    <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg">Salvar Alterações</button>
  </form>
</div>
  </div>
</AdminLayout>
```