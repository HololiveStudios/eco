---
// src/pages/admin/orders/[id].astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAllOrders, getOrder } from '../../../stores/orders';
import { formatPrice, formatDate } from '../../../lib/format';

export async function getStaticPaths() {
  const orders = getAllOrders();
  return orders.map(order => ({
    params: { id: order.id },
    props: { order }
  }));
}

const { order } = Astro.props;
---

<AdminLayout title={`Pedido ${order.id}`}>
  <div class="max-w-4xl">
    <div class="flex items-center justify-between mb-6">
      <a href="/admin/orders" class="text-primary hover:underline flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Voltar para Pedidos
      </a>
      
      <button
        id="send-whatsapp"
        class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 flex items-center gap-2"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Enviar para WhatsApp
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-sm text-gray-600 mb-2">Status</h3>
        <select class="w-full px-3 py-2 border rounded-lg" id="order-status">
          <option value="pending" selected={order.status === 'pending'}>Pendente</option>
          <option value="paid" selected={order.status === 'paid'}>Pago</option>
          <option value="shipped" selected={order.status === 'shipped'}>Enviado</option>
          <option value="delivered" selected={order.status === 'delivered'}>Entregue</option>
        </select>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-sm text-gray-600 mb-2">Data do Pedido</h3>
        <p class="text-lg font-semibold">{formatDate(order.createdAt)}</p>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-sm text-gray-600 mb-2">Total</h3>
        <p class="text-2xl font-bold text-primary">{formatPrice(order.total)}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h2 class="font-bold text-xl mb-4">Informações do Cliente</h2>
        <div class="space-y-3">
          <div>
            <p class="text-sm text-gray-600">Nome</p>
            <p class="font-semibold">{order.customer.name}</p>
          </div>
          <div>
            <p class="text-sm text-gray-600">E-mail</p>
            <p class="font-semibold">{order.customer.email}</p>
          </div>
          <div>
            <p class="text-sm text-gray-600">Telefone</p>
            <p class="font-semibold">{order.customer.phone}</p>
          </div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h2 class="font-bold text-xl mb-4">Endereço de Entrega</h2>
        <div class="space-y-1">
          <p>{order.customer.address.street}, {order.customer.address.number}</p>
          {order.customer.address.complement && <p>{order.customer.address.complement}</p>}
          <p>{order.customer.address.district}</p>
          <p>{order.customer.address.city} - {order.customer.address.state}</p>
          <p>CEP: {order.customer.address.zipCode}</p>
        </div>
      </div>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-sm mt-6">
      <h2 class="font-bold text-xl mb-4">Itens do Pedido</h2>
      <div class="space-y-4">
        {order.items.map(item => (
          <div class="flex justify-between items-center py-3 border-b">
            <div>
              <p class="font-semibold">Produto {item.productId}</p>
              <p class="text-sm text-gray-600">Quantidade: {item.quantity}</p>
            </div>
            <p class="font-semibold">{formatPrice(item.price * item.quantity)}</p>
          </div>
        ))}
        <div class="flex justify-between items-center text-lg font-bold pt-4">
          <span>Total:</span>
          <span class="text-primary">{formatPrice(order.total)}</span>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ order }}>
    import { updateOrderStatus } from '../../../stores/orders';
    import { formatPrice } from '../../../lib/format';

    document.getElementById('order-status')?.addEventListener('change', (e) => {
      const status = (e.target as HTMLSelectElement).value;
      updateOrderStatus(order.id, status);
      alert('Status atualizado com sucesso!');
    });

    document.getElementById('send-whatsapp')?.addEventListener('click', () => {
      const phone = '5511999999999'; // Substitua pelo seu número
      
      let message = `🛒 *Pedido ${order.id}*\n\n`;
      message += `👤 *Cliente:* ${order.customer.name}\n`;
      message += `📧 *E-mail:* ${order.customer.email}\n`;
      message += `📱 *Telefone:* ${order.customer.phone}\n\n`;
      
      message += `📦 *Produtos:*\n`;
      order.items.forEach((item) => {
        message += `• Produto ${item.productId} - ${item.quantity}x - ${formatPrice(item.price * item.quantity)}\n`;
      });
      
      message += `\n📍 *Endereço:*\n`;
      message += `${order.customer.address.street}, ${order.customer.address.number}\n`;
      if (order.customer.address.complement) {
        message += `${order.customer.address.complement}\n`;
      }
      message += `${order.customer.address.district} - ${order.customer.address.city}/${order.customer.address.state}\n`;
      message += `CEP: ${order.customer.address.zipCode}\n\n`;
      
      message += `💵 *Total:* ${formatPrice(order.total)}\n`;
      message += `📊 *Status:* ${order.status}`;
      
      const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank');
    });
  </script>
</AdminLayout>