---
// src/pages/admin/login.astro
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Admin</title>
</head>
<body class="bg-gray-100">
  <div class="min-h-screen flex items-center justify-center">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
      <h1 class="text-3xl font-bold mb-6 text-center">Admin Login</h1>
      
      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-2">E-mail</label>
          <input
            type="email"
            name="email"
            required
            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary"
            placeholder="admin@admin.com"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-2">Senha</label>
          <input
            type="password"
            name="password"
            required
            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary"
            placeholder="admin123"
          />
        </div>

        <div id="error" class="text-red-500 text-sm hidden"></div>

        <button
          type="submit"
          class="w-full bg-primary text-white py-3 rounded-lg font-semibold hover:bg-primary/90"
        >
          Entrar
        </button>
      </form>

      <p class="text-center text-sm text-gray-600 mt-4">
        Use: admin@admin.com / admin123
      </p>
    </div>
  </div>

  <script>
    import { login } from '../../lib/auth';

    document.getElementById('login-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target as HTMLFormElement);
      const email = formData.get('email') as string;
      const password = formData.get('password') as string;
      
      if (login(email, password)) {
        window.location.href = '/admin';
      } else {
        const errorEl = document.getElementById('error');
        if (errorEl) {
          errorEl.textContent = 'Credenciais inválidas';
          errorEl.classList.remove('hidden');
        }
      }
    });
  </script>
</body>
</html>