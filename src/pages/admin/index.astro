---
// src/pages/admin/index.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatsCard from '../../components/admin/StatsCard';
import { getAllOrders } from '../../stores/orders';
import { getAllAdminProducts } from '../../stores/admin-products';
import { formatPrice } from '../../lib/format';

const orders = getAllOrders();
const products = getAllAdminProducts();

const totalRevenue = orders.reduce((sum, order) => sum + order.total, 0);
const pendingOrders = orders.filter(o => o.status === 'pending').length;
---

<AdminLayout title="Dashboard">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <StatsCard
      title="Receita Total"
      value={formatPrice(totalRevenue)}
      icon="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
      trend={{ value: 12.5, isPositive: true }}
      client:load
    />
    
    <StatsCard
      title="Total de Pedidos"
      value={orders.length}
      icon="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
      trend={{ value: 8.2, isPositive: true }}
      client:load
    />
    
    <StatsCard
      title="Produtos Cadastrados"
      value={products.length}
      icon="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
      client:load
    />
    
    <StatsCard
      title="Pedidos Pendentes"
      value={pendingOrders}
      icon="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
      trend={{ value: 3.1, isPositive: false }}
      client:load
    />
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-lg shadow-sm">
      <h2 class="text-xl font-bold mb-4">Pedidos Recentes</h2>
      <div class="space-y-4">
        {orders.slice(0, 5).map(order => (
          <div class="flex items-center justify-between py-3 border-b">
            <div>
              <p class="font-semibold">{order.id}</p>
              <p class="text-sm text-gray-600">{order.customer.name}</p>
            </div>
            <div class="text-right">
              <p class="font-semibold">{formatPrice(order.total)}</p>
              <span class={`text-xs px-2 py-1 rounded ${
                order.status === 'delivered' ? 'bg-green-100 text-green-800' :
                order.status === 'shipped' ? 'bg-blue-100 text-blue-800' :
                order.status === 'paid' ? 'bg-yellow-100 text-yellow-800' :
                'bg-gray-100 text-gray-800'
              }`}>
                {order.status}
              </span>
            </div>
          </div>
        ))}
      </div>
      <a href="/admin/orders" class="block text-center text-primary font-semibold mt-4 hover:underline">
        Ver Todos os Pedidos
      </a>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-sm">
      <h2 class="text-xl font-bold mb-4">Produtos com Baixo Estoque</h2>
      <div class="space-y-4">
        {products.filter(p => p.stock < 10).slice(0, 5).map(product => (
          <div class="flex items-center justify-between py-3 border-b">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-gray-200 rounded" />
              <div>
                <p class="font-semibold">{product.name}</p>
                <p class="text-sm text-gray-600">{product.category}</p>
              </div>
            </div>
            <span class="text-red-600 font-semibold">{product.stock} unidades</span>
          </div>
        ))}
      </div>
      <a href="/admin/products" class="block text-center text-primary font-semibold mt-4 hover:underline">
        Ver Todos os Produtos
      </a>
    </div>
  </div>
</AdminLayout>